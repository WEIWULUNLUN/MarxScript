.pitem {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #eef2f6;
}

.pitem:last-child {
  border-bottom: none;
}

.pitem-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pitem-title {
  font-size: 29rpx;
  font-weight: 600;
  flex: 1;
  min-width: 0;
}

.pitem-count {
  font-size: 22rpx;
  color: #9aa8b6;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.pitem-body {
  margin-top: 8rpx;
  font-size: 25rpx;
  color: #5b6b7d;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.pitem-act {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.pitem-act .btn {
  margin: 0 12rpx 12rpx 0;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(16, 25, 33, 0.45);
  z-index: 90;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 91;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 28rpx 28rpx 0;
  transform: translateY(110%);
  transition: transform 0.22s ease;
}

.sheet.show {
  transform: translateY(0);
}

.sheet-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
}

.sheet-label {
  font-size: 26rpx;
  color: #6b7a8c;
  margin: 18rpx 0 10rpx;
}

.sheet-ta {
  width: 100%;
  height: 320rpx;
  background: #f8fafc;
  border: 1rpx solid #e7edf3;
  border-radius: 16rpx;
  padding: 18rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.sheet-foot {
  display: flex;
  margin: 24rpx 0 12rpx;
}

.sheet-foot .btn {
  margin-right: 20rpx;
}

.sheet-foot .btn:last-child {
  margin-right: 0;
}

.ph {
  color: #a8b4c0;
}
