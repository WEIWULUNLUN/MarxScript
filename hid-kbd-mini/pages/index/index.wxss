
.devbar {
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
  background: #fff;
  border-radius: 22rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 18rpx rgba(22, 33, 43, 0.05);
  border-left: 8rpx solid #c9d6de;
}

.devbar.is-warn {
  border-left-color: #f5a524;
  background: #fffdf6;
}

.devbar.is-ok {
  border-left-color: #12a594;
  background: #f6fdfc;
}

.devbar-hover {
  opacity: 0.9;
}

.devbar-main {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.devbar-name {
  font-size: 30rpx;
  font-weight: 600;
}

.devbar-sub {
  font-size: 23rpx;
  color: #6b7a8c;
  margin-top: 2rpx;
}

.devbar-action {
  font-size: 25rpx;
  color: #0e7c86;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #e8f5f6;
  flex-shrink: 0;
}

.ta {
  width: 100%;
  height: 300rpx;
  font-size: 32rpx;
  line-height: 1.6;
  padding: 20rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  border: 1rpx solid #e7edf3;
}

.ph {
  color: #a8b4c0;
  font-size: 28rpx;
}

.ta-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.hint {
  font-size: 23rpx;
  color: #8a97a6;
}

.hint.warn {
  color: #d98a00;
}

.link {
  font-size: 25rpx;
  color: #0e7c86;
  padding: 4rpx 6rpx;
}

.sendbox {
  margin-bottom: 24rpx;
}

.sendbtn {
  height: 118rpx;
  line-height: 1.25;
  font-size: 33rpx;
  letter-spacing: 1rpx;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.btn-main {
  font-size: 33rpx;
  font-weight: 600;
  line-height: 1.3;
}

.btn-sub {
  font-size: 22rpx;
  opacity: 0.85;
  margin-top: 6rpx;
  font-weight: 400;
  letter-spacing: 0;
}

.kbd-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-hover {
  background: #f4f9fa;
}

.kbd-entry-main {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.kbd-entry-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1d2b3a;
  margin-bottom: 4rpx;
}

.arrow {
  font-size: 40rpx;
  color: #b6c2cf;
  line-height: 1;
}

.safe-bottom {
  height: 40rpx;
}

.progress {
  height: 10rpx;
  border-radius: 999rpx;
  background: #e2ebf0;
  overflow: hidden;
  margin-top: 16rpx;
}

.progress-bar {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #12a594, #0e7c86);
  transition: width 0.2s linear;
}

.sendtip {
  text-align: center;
  font-size: 23rpx;
  color: #9aa8b6;
  margin-top: 12rpx;
}

.trace {
  margin-top: 10rpx;
  text-align: center;
  font-size: 20rpx;
  color: #9aa8b6;
  line-height: 1.45;
  word-break: break-all;
}

.chips {
  white-space: nowrap;
  display: flex;
}

.chip {
  display: inline-block;
  flex-shrink: 0;
  padding: 16rpx 24rpx;
  margin-right: 16rpx;
  border-radius: 16rpx;
  background: #f2f7f9;
  border: 1rpx solid #e2edf0;
}

.chip-t {
  font-size: 26rpx;
  color: #16212b;
}
