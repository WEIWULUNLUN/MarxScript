
page {
  --brand: #0e7c86;
  --brand-2: #12a594;
  --brand-light: #e8f5f6;
  --bg: #f2f6f9;
  --card: #ffffff;
  --text: #16212b;
  --sub: #6b7a8c;
  --line: #e7edf3;
  --danger: #e0454a;
  --warn: #f5a524;
  --ok: #12a594;
  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.55;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Helvetica,
    "Microsoft YaHei", sans-serif;
}

view,
text,
input,
textarea,
button,
scroll-view {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 60rpx;
}

.card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 18rpx rgba(22, 33, 43, 0.05);
}

.card-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

.card-title::before {
  content: "";
  display: inline-block;
  width: 6rpx;
  height: 26rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, var(--brand-2), var(--brand));
  margin-right: 14rpx;
  vertical-align: -3rpx;
}

.muted {
  color: var(--sub);
  font-size: 24rpx;
}

.row {
  display: flex;
  align-items: center;
}

.between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex1 {
  flex: 1;
  min-width: 0;
}

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.btn {
  margin: 0;
  padding: 0 30rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 20rpx;
  font-size: 29rpx;
  font-weight: 500;
  text-align: center;
  border: none;
  background: #eef2f6;
  color: var(--text);
}

.btn::after {
  border: none;
}

.btn.primary {
  background: linear-gradient(135deg, var(--brand-2), var(--brand));
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(14, 124, 134, 0.24);
}

.btn.primary[disabled] {
  background: #c9d6de;
  color: #f4f8fa;
  box-shadow: none;
}

.btn.ghost {
  background: #fff;
  color: var(--brand);
  border: 1rpx solid rgba(14, 124, 134, 0.35);
}

.btn.danger {
  background: #fdecec;
  color: var(--danger);
}

.btn.sm {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 22rpx;
  font-size: 25rpx;
  border-radius: 16rpx;
}

.btn.block {
  width: 100%;
}

.btn-hover {
  opacity: 0.82;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #c3ced9;
  flex-shrink: 0;
}

.dot.on {
  background: var(--ok);
  box-shadow: 0 0 0 6rpx rgba(18, 165, 148, 0.15);
}

.dot.warn {
  background: var(--warn);
  box-shadow: 0 0 0 6rpx rgba(245, 165, 36, 0.15);
}

.dot.err {
  background: var(--danger);
  box-shadow: 0 0 0 6rpx rgba(224, 69, 74, 0.15);
}

.tag {
  display: inline-block;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  background: var(--brand-light);
  color: var(--brand);
  line-height: 1.7;
}

.tag.gray {
  background: #eef2f6;
  color: var(--sub);
}

.field {
  display: flex;
  align-items: center;
  min-height: 92rpx;
  border-bottom: 1rpx solid var(--line);
}

.field:last-child {
  border-bottom: none;
}

.field-label {
  width: 200rpx;
  color: var(--text);
  font-size: 28rpx;
  flex-shrink: 0;
}

.field-value {
  flex: 1;
  text-align: right;
  color: var(--sub);
  font-size: 26rpx;
}

.input {
  flex: 1;
  height: 92rpx;
  font-size: 28rpx;
  text-align: right;
}

.empty {
  padding: 60rpx 0;
  text-align: center;
  color: #9aa8b6;
  font-size: 25rpx;
}

.divider {
  height: 1rpx;
  background: var(--line);
  margin: 20rpx 0;
}

.safe-bottom {
  height: calc(env(safe-area-inset-bottom) + 20rpx);
}
